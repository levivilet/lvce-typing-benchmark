{
  "name": "lvce-typing-benchmark",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "analyze": "node src/analyzeCli.ts",
    "benchmark": "npm run setup && node src/main.ts",
    "benchmark:ci": "node src/runCiBenchmark.ts",
    "benchmark:render": "npm run setup && node src/renderMain.ts",
    "benchmark:render:ci": "node src/runCiRenderBenchmark.ts",
    "benchmark:startup": "npm run setup && node src/startupMain.ts",
    "benchmark:startup:ci": "node src/runCiStartupBenchmark.ts",
    "ci:report": "node src/generateCiReport.ts",
    "install-browser:ci": "playwright install --with-deps chromium",
    "lint": "eslint .",
    "report": "node src/reportCli.ts",
    "report:render": "node src/renderReportCli.ts",
    "report:startup": "node src/startupReportCli.ts",
    "setup": "node src/setup.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "type-check": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@codemirror/lang-html": "6.4.11",
    "@github1s/vscode-web": "0.27.0",
    "@lvce-editor/editor-worker": "19.27.0",
    "@lvce-editor/renderer-process": "30.19.0",
    "@lvce-editor/server": "0.93.17",
    "@lvce-editor/static-server": "0.93.17",
    "@lvce-editor/syntax-highlighting-worker": "2.4.3",
    "codemirror": "6.0.2",
    "monaco-editor": "0.56.0"
  },
  "devDependencies": {
    "@lvce-editor/eslint-config": "^17.5.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@types/node": "^24.10.1",
    "eslint": "^10.7.0",
    "playwright": "^1.57.0",
    "rollup": "^4.62.3",
    "rollup-plugin-css-only": "^4.5.5",
    "typescript": "^5.9.3"
  }
}
